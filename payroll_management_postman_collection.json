{
	"info": {
		"_postman_id": "team4-payroll-apis",
		"name": "TripWise Team 4 - Payroll Management REST APIs",
		"description": "Postman Collection for testing Team 4's Inbound and Outbound REST API Integrations.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Outbound APIs (Data Provisioning)",
			"item": [
				{
					"name": "Team 8 - Legal Compliance Review",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/payroll/compliance-review",
							"host": ["{{base_url}}"],
							"path": ["api", "payroll", "compliance-review"]
						}
					}
				},
				{
					"name": "Team 5 - Financial Disbursement Totals",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/payroll/disbursements",
							"host": ["{{base_url}}"],
							"path": ["api", "payroll", "disbursements"]
						}
					}
				},
				{
					"name": "Team 9 - Driver Net Earnings",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/payroll/driver-earnings/1",
							"host": ["{{base_url}}"],
							"path": ["api", "payroll", "driver-earnings", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Inbound Webhooks (Ingesting External Data)",
			"item": [
				{
					"name": "Team 1 - Ingest New Hire",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"department_id\": 1,\n  \"first_name\": \"Alexander\",\n  \"last_name\": \"Cruz\",\n  \"email\": \"alexander.cruz@example.com\",\n  \"position\": \"TNVS Senior Driver\",\n  \"daily_rate\": 850.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/payroll/webhooks/new-hire",
							"host": ["{{base_url}}"],
							"path": ["api", "payroll", "webhooks", "new-hire"]
						}
					}
				},
				{
					"name": "Team 2 - Ingest Attendance",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"employee_id\": 1,\n  \"cutoff_period\": \"2026-07-01_15\",\n  \"days_worked\": 11,\n  \"lates_count\": 0\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/payroll/webhooks/attendance",
							"host": ["{{base_url}}"],
							"path": ["api", "payroll", "webhooks", "attendance"]
						}
					}
				},
				{
					"name": "Team 3 - Ingest Performance Bonus",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"employee_id\": 1,\n  \"cutoff_period\": \"2026-07-01_15\",\n  \"bonus_amount\": 1500.00,\n  \"reason\": \"Exceptional customer rating\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/payroll/webhooks/bonus",
							"host": ["{{base_url}}"],
							"path": ["api", "payroll", "webhooks", "bonus"]
						}
					}
				},
				{
					"name": "Team 9 - Ingest Driver Trip Income",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"employee_id\": 1,\n  \"cutoff_period\": \"2026-07-01_15\",\n  \"total_trips\": 35,\n  \"total_trip_earnings\": 5250.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/payroll/webhooks/trip-income",
							"host": ["{{base_url}}"],
							"path": ["api", "payroll", "webhooks", "trip-income"]
						}
					}
				},
				{
					"name": "Team 8 - Ingest Legal Decision (Approve/Reject)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"salary_computation_id\": 1,\n  \"decision\": \"approved_legal\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/payroll/webhooks/legal-decision",
							"host": ["{{base_url}}"],
							"path": ["api", "payroll", "webhooks", "legal-decision"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000"
		}
	]
}
